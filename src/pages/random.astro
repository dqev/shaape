---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import MainApp from '../components/sections/MainApp';
import '../styles/global.css';

const title = "Random Shape Generator | Shaape - Infinite Abstract SVG Shapes";
const description = "Generate infinite unique abstract SVG vector shapes with procedural lighting, grainy noise gradients, and 3D tilt. Copy SVG code or export in 4x PNG.";
const canonicalURL = "https://shaape.co/random";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://shaape.co/#website",
      "url": "https://shaape.co",
      "name": "Shaape",
      "inLanguage": "en"
    },
    {
      "@type": "WebApplication",
      "@id": "https://shaape.co/random#app",
      "name": "Shaape Random Shape Generator",
      "url": "https://shaape.co/random",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and HTML5 Canvas support",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Procedural generator for customizable abstract SVG shapes with normal, gradient, and feTurbulence grainy noise textures.",
      "featureList": [
        "Infinite procedural abstract shape generation across 4 core topologies",
        "Interactive 3D tilt and Space key / click shake physics",
        "Instant SVG code copy and 4x high-resolution PNG export",
        "Custom color palette picker and procedural feTurbulence noise",
        "100% free for commercial and personal projects without attribution"
      ],
      "creator": {
        "@type": "Person",
        "name": "Dev Chauhan"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://shaape.co"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Random Generator",
          "item": "https://shaape.co/random"
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} jsonLd={jsonLd}>
  <Header />
  <Container>
    <MainApp client:visible initialView="random" />

    <noscript>
      <section class="noscript-content" style="padding: 2rem 0; text-align: center;">
        <h2>Random Procedural Abstract SVG Shape Generator</h2>
        <p>
          Generate randomized abstract vectors with custom colors, gradients, and grainy textures. Press Space or shake to generate new shapes with instant SVG code copy.
        </p>
      </section>
    </noscript>
  </Container>
  <Footer />
</BaseLayout>
