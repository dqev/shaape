---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import MainApp from '../components/sections/MainApp';
import '../styles/global.css';

const title = "All Abstract Shapes | Shaape - 530+ Vector Assets & Grainy Shapes";
const description = "Browse all 530+ free abstract SVG shapes and vector assets. Filter across Badges, Arrows, Cyber, Flowers, Stars, and Geometric seals.";
const canonicalURL = "https://shaape.co/shapes";
const image = "https://shaape.co/og.png";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} image={image}>
  <Header />
  <Container>
    <MainApp client:visible initialView="catalog" />

    <noscript>
      <section class="noscript-content" style="padding: 2rem 0; text-align: center;">
        <h2>Free Vector Abstract Shapes &amp; Grainy Gradients</h2>
        <p>
          Shaape provides 530+ scalable vector shapes across diverse categories: Badges, Arrows, Cyber, Flowers, Stars, and Geometric seals. Available in smooth normal, gradient, and procedural grainy noise styles with instant SVG and 4x PNG exports.
        </p>
      </section>
    </noscript>
  </Container>
  <Footer />
</BaseLayout>
