---
import BaseLayout from '../layouts/BaseLayout.astro';
import { demoShapes } from '../data/demoShapes';
import '../styles/global.css';

const title = "Shaape | Clean SVG Abstract Shapes & Vector Library";
const description = "Discover 440+ free abstract SVG shapes and grainy vector assets. Generate random shapes or browse handcrafted collections for modern web interfaces.";
const canonicalURL = "https://shaape.co";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <main class="home-viewport-canvas">
    <header class="home-shapes-row" aria-label="Featured abstract shapes">
      {demoShapes.map((shape) => (
        <div class="showcase-shape" aria-label={shape.name} role="img" set:html={shape.svg} />
      ))}
    </header>

    <footer class="home-bottom-content">
      <div class="home-hero-lockup">
        <h1 class="hero-brand-title">
          <span class="hero-brand-emblem" aria-hidden="true">
            <img
              src="/logo.svg"
              alt="Shaape Emblem"
              width="36"
              height="36"
              draggable="false"
              class="hero-emblem-img"
            />
          </span>
          <span class="hero-brand-text">shaape.co</span>
        </h1>
        <p class="hero-brand-subtitle">
          A collection of clean SVG abstract shapes and vector assets for web &amp; UI interfaces.
        </p>

        <div class="hero-buttons-row">
          <a
            href="/shapes"
            class="rounded-btn rounded-btn-primary"
            id="btnExploreShapes"
            title="Browse all 440+ vector shapes"
          >
            Shapes
          </a>

          <a
            href="/random"
            class="rounded-btn rounded-btn-secondary"
            id="btnRandomGenerator"
            title="Open random shape generator"
          >
            Random
          </a>
        </div>
      </div>

      <div class="home-footer-credit">
        <p class="home-footer-text">
          Built by <a
            href="https://x.com/devchauhann3"
            target="_blank"
            rel="noopener noreferrer"
            class="home-footer-link"
          ><img
              src="/pfp.svg"
              alt="Dev Chauhan"
              class="footer-pfp"
              width="18"
              height="18"
              loading="lazy"
              decoding="async"
            /><span>Dev Chauhan.</span></a> The source code is available on <a
            href="https://github.com/dqev/shaape"
            target="_blank"
            rel="noopener noreferrer"
            class="home-footer-link"
          >GitHub.</a>
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(body) {
    overflow-x: hidden;
    background: #ffffff;
    margin: 0;
    padding: 0;
  }

  :global(html.dark body) {
    background: #09090b;
  }

  .home-viewport-canvas {
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    background: transparent;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
    overflow-x: hidden;
  }

  .home-shapes-row {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0 !important;
    width: 100%;
    max-width: 100%;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .showcase-shape {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default !important;
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -webkit-user-drag: none !important;
    margin: 0;
    padding: 0;
  }

  .showcase-shape-img,
  .showcase-shape :global(svg),
  .showcase-shape-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -webkit-user-drag: none !important;
  }

  .home-bottom-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    padding: clamp(24px, 4vw, 48px) clamp(24px, 4.5vw, 60px);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    gap: 32px;
  }

  .home-hero-lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 560px;
    width: 100%;
  }

  .home-footer-credit {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .home-footer-text {
    font-size: 13.5px;
    color: #71717a;
    font-family: inherit;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.6;
  }

  :global(html.dark) .home-footer-text {
    color: #a1a1aa;
  }

  .home-footer-link {
    color: inherit;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: currentColor;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    vertical-align: middle;
    transition: color 0.15s ease;
  }

  .home-footer-link:hover {
    color: #18181b;
  }

  :global(html.dark) .home-footer-link:hover {
    color: #f4f4f5;
  }

  .footer-pfp {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .hero-brand-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(2.1rem, 3.4vw, 2.9rem);
    font-weight: 600;
    color: #18181b;
    letter-spacing: -0.035em;
    margin: 0;
    line-height: 1.12;
  }

  :global(html.dark) .hero-brand-title {
    color: #f4f4f5;
  }

  .hero-brand-emblem {
    width: clamp(34px, 2.8vw, 44px);
    height: clamp(34px, 2.8vw, 44px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    pointer-events: none;
    user-select: none;
  }

  .hero-emblem-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.08));
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-drag: none !important;
  }

  .hero-brand-text {
    display: inline-block;
  }

  .hero-brand-subtitle {
    font-size: clamp(0.96rem, 1.2vw, 1.08rem);
    color: #52525b;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 12px 0 22px 0;
    max-width: 440px;
  }

  :global(html.dark) .hero-brand-subtitle {
    color: #a1a1aa;
  }

  .hero-buttons-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .rounded-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 42px;
    min-width: 120px;
    padding: 0 24px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    border: none;
    box-shadow: none;
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.14s var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
      background-color 0.14s ease,
      opacity 0.14s ease;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }

  .rounded-btn:hover {
    transform: none;
  }

  .rounded-btn:active {
    transform: scale(0.96);
    transition-duration: 0.08s;
  }

  .rounded-btn-primary {
    background: #18181b;
    color: #ffffff;
  }

  .rounded-btn-primary:hover {
    background: #27272a;
  }

  :global(html.dark) .rounded-btn-primary {
    background: #f4f4f5;
    color: #18181b;
  }

  :global(html.dark) .rounded-btn-primary:hover {
    background: #ffffff;
  }

  .rounded-btn-secondary {
    background: #f4f4f5;
    color: #18181b;
  }

  .rounded-btn-secondary:hover {
    background: #e4e4e7;
  }

  :global(html.dark) .rounded-btn-secondary {
    background: #18181b;
    color: #f4f4f5;
  }

  :global(html.dark) .rounded-btn-secondary:hover {
    background: #27272a;
  }

  @media (max-width: 900px) {
    .home-shapes-row {
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .home-shapes-row::-webkit-scrollbar {
      display: none;
    }

    .showcase-shape {
      flex: 0 0 20% !important;
      width: 20% !important;
      min-width: 20% !important;
      max-width: 20% !important;
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 640px) {
    .home-viewport-canvas {
      padding: 0;
    }

    .home-bottom-content {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 20px 32px 20px;
      gap: 22px;
    }

    .home-footer-credit {
      justify-content: flex-start;
      margin-top: 4px;
    }

    .hero-brand-title {
      font-size: 1.85rem;
      gap: 10px;
    }

    .hero-brand-emblem {
      width: 32px;
      height: 32px;
    }

    .hero-brand-subtitle {
      font-size: 0.9rem;
      margin: 10px 0 18px 0;
    }

    .hero-buttons-row {
      gap: 8px;
      flex-wrap: wrap;
    }

    .rounded-btn {
      flex: 1 1 0;
      min-width: 0;
      padding: 0 16px;
      height: 42px;
      font-size: 13.5px;
    }
  }
</style>

<script is:inline>
  (function () {
    window.addEventListener('dragstart', (e) => {
      if (e.target && (e.target.tagName === 'IMG' || e.target.tagName === 'svg')) {
        e.preventDefault();
      }
    });
  })();
</script>
